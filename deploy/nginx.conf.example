server {
    listen 80;
    listen [::]:80;
    server_name padronizador.leadcode.com.br;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name padronizador.leadcode.com.br;

    ssl_certificate     /etc/letsencrypt/live/padronizador.leadcode.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/padronizador.leadcode.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Upload de .docx com anexos
    client_max_body_size 100M;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # FastAPI: /api/v1/*, /health, OpenAPI
    location /api/ {
        proxy_pass http://127.0.0.1:8150;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8150/health;
        proxy_read_timeout 30s;
    }

    location = /openapi.json {
        proxy_pass http://127.0.0.1:8150/openapi.json;
    }

    location /docs {
        proxy_pass http://127.0.0.1:8150;
    }

    # Next.js
    location / {
        proxy_pass http://127.0.0.1:3050;
        proxy_read_timeout 120s;
    }
}
